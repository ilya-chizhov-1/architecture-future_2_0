        </mxCell>
        <mxCell id="pl_bi" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4527A0;fontSize=13;fontColor=#311B92;" value="&lt;b&gt;BI&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;Power BI поверх Semantic Layer (опционально)&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#263238&quot;&gt;классические дашборды для уже мигрированных отчётов&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="610" x="2040" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="int_api" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=13;fontColor=#BF360C;" value="&lt;b&gt;Шлюз API&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;Kong / Envoy&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#263238&quot;&gt;внешние интерфейсы доменов для клиентов и партнёров&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="600" x="60" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="int_esb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;dashed=1;fontSize=13;fontColor=#BF360C;" value="&lt;b&gt;ESB (Apache Camel) - тонкий адаптер к легаси&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;функции шины разбираются на специализированные компоненты&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#C62828&quot;&gt;Было:&lt;/font&gt; всё-в-одном - ФЛК (формат и логика), трансформации, протокольные адаптеры, маршрутизация, оркестрация, бизнес-логика, retry / DLQ, сквозной мониторинг (bottleneck).&lt;br/&gt;&lt;font color=&quot;#2E7D32&quot;&gt;Становится:&lt;/font&gt; ФЛК формат - Schema Registry; ФЛК логика - Great Expectations / Soda и валидация в доменах-продюсерах; трансформации - Kafka Streams / Flink + dbt; протоколы - API Gateway и Kafka Connect; маршрутизация - Kafka topics; оркестрация и SAGA - Workflow Engine; бизнес-логика - доменные сервисы; retry / DLQ - retry-топики Kafka + встроенно в Workflow Engine и API Gateway; сквозная трассировка - OpenTelemetry и lineage в каталоге. В ESB остаются только коннекторы к legacy на переходный период." vertex="1">
          <mxGeometry height="240" width="780" x="690" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="int_workflow" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=13;fontColor=#BF360C;" value="&lt;b&gt;Оркестрация бизнес-процессов&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;Temporal / Camunda / Zeebe&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#263238&quot;&gt;SAGA, длинные workflows, координация между доменами. Снимает оркестрацию с шины.&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="600" x="1500" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="int_sso" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=13;fontColor=#BF360C;" value="&lt;b&gt;Единый вход (SSO)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;Keycloak (OIDC + SAML 2.0)&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#263238&quot;&gt;общий источник учётных записей для всех систем&lt;/font&gt;" vertex="1">
          <mxGeometry height="240" width="610" x="2130" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="leg_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#C62828;" value="В процессе вывода из эксплуатации" vertex="1">
