        <mxCell id="E3" value="&lt;b&gt;Клиент / пациент&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;пользуется приложениями клиники и банка" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#263238;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
