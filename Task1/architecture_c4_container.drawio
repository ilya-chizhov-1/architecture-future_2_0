        </mxCell>
        <mxCell id="pl_cat" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4527A0;fontSize=13;fontColor=#311B92;" value="&lt;b&gt;Каталог данных и управление качеством&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;OpenMetadata / DataHub + Schema Registry (Confluent / Apicurio)&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#263238&quot;&gt;поиск данных, контракты, схемы потоков, происхождение, аудит&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="610" x="90" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="pl_iam" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4527A0;fontSize=13;fontColor=#311B92;" value="&lt;b&gt;Управление доступом к данным&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;Keycloak + Apache Ranger (row-level security)&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#263238&quot;&gt;единые роли и атрибутивное разграничение до уровня строк&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="610" x="740" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="pl_ss" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#4527A0;fontSize=14;fontStyle=1;fontColor=#311B92;" value="&lt;b&gt;Портал самообслуживания (витрина)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#37474F&quot;&gt;&lt;i&gt;Apache Superset / Metabase&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#263238&quot;&gt;конструктор отчётов для бизнеса, главная точка доступа&lt;/font&gt;" vertex="1">
