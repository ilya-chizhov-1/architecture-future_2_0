<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="dfd-l1" name="DFD уровень 1 (Gane-Sarson)">
    <mxGraphModel dx="2600" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================= TITLE ========================= -->
        <mxCell id="title" value="«Будущее 2.0» - потоки данных между доменами (DFD, уровень 1, нотация Gane-Sarson)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
