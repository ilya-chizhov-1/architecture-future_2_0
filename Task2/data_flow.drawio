        <!-- ========================= EXTERNAL ENTITIES ========================= -->
        <mxCell id="E1" value="&lt;b&gt;Оператор / врач&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;работает с пациентом в клинике" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#263238;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
