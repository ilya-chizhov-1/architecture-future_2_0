        <mxCell id="dot_21" value="21" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F57F17;strokeColor=#E65100;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
