        <mxCell id="E2" value="&lt;b&gt;Бизнес-пользователь&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;аналитик и руководитель, строит отчёты" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#263238;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
