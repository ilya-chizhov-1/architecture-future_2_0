        <mxCell id="dot_23" value="23" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F57F17;strokeColor=#E65100;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1344" y="1204" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="dot_24" value="24" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F57F17;strokeColor=#E65100;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1504" y="1264" width="32" height="32" as="geometry" />
        </mxCell>

        <!-- ======= LEGEND PANEL (right) ======= -->
        <mxCell id="q1_h" value="Платформа данных и хранение" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1976D2;strokeColor=#0D47A1;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1740" y="100" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="q1_b" value="&lt;b&gt;1.&lt;/b&gt; Object Storage &lt;i&gt;- основа для отчётности и любого нового бизнеса&lt;/i&gt;&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; Lakehouse (Iceberg / Delta) &lt;i&gt;- единое хранилище для витрины самообслуживания&lt;/i&gt;&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; CDC (Debezium) &lt;i&gt;- независимые релизы финтеха, подключение партнёров&lt;/i&gt;&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Streaming (Kafka) &lt;i&gt;- быстрая подача данных от доменов к платформе&lt;/i&gt;&lt;br/&gt;&lt;b&gt;5.&lt;/b&gt; Semantic Layer &lt;i&gt;- быстрая отчётность, единые метрики для бизнеса&lt;/i&gt;&lt;br/&gt;&lt;b&gt;6.&lt;/b&gt; SQL Server 2008 DWH &lt;i&gt;- блокирует все цели, снят с поддержки вендором&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1740" y="136" width="1000" height="230" as="geometry" />
        </mxCell>

        <mxCell id="q2_h" value="Интеграция и инфраструктура" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#388E3C;strokeColor=#1B5E20;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1740" y="386" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="q2_b" value="&lt;b&gt;7.&lt;/b&gt; API Gateway &lt;i&gt;- независимое развитие финтеха, подключение партнёров&lt;/i&gt;&lt;br/&gt;&lt;b&gt;8.&lt;/b&gt; Managed Kubernetes &lt;i&gt;- качество и отказоустойчивость сервисов&lt;/i&gt;&lt;br/&gt;&lt;b&gt;9.&lt;/b&gt; SSO (OIDC) &lt;i&gt;- комплаенс, безопасный широкий доступ к витрине&lt;/i&gt;&lt;br/&gt;&lt;b&gt;10.&lt;/b&gt; Terraform (инфраструктура как код) &lt;i&gt;- масштабирование на новые бизнесы&lt;/i&gt;&lt;br/&gt;&lt;b&gt;11.&lt;/b&gt; Service Mesh &lt;i&gt;- наблюдаемость и безопасность трафика между доменами&lt;/i&gt;&lt;br/&gt;&lt;b&gt;12.&lt;/b&gt; ESB как шина данных &lt;i&gt;- уходит из роли массового перелива, остаётся только для процессов&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#388E3C;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1740" y="422" width="1000" height="230" as="geometry" />
        </mxCell>

        <mxCell id="q3_h" value="ИИ и аналитика" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7B1FA2;strokeColor=#4A148C;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1740" y="672" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="q3_b" value="&lt;b&gt;13.&lt;/b&gt; Портал самообслуживания и BI &lt;i&gt;- быстрая отчётность без обращений в ИТ&lt;/i&gt;&lt;br/&gt;&lt;b&gt;14.&lt;/b&gt; Python для ML &lt;i&gt;- независимое развитие ИИ-сервисов&lt;/i&gt;&lt;br/&gt;&lt;b&gt;15.&lt;/b&gt; Feature Store &lt;i&gt;- ускоряет ИИ-эксперименты и риск-скоринг в финтехе&lt;/i&gt;&lt;br/&gt;&lt;b&gt;16.&lt;/b&gt; Data Catalog и lineage &lt;i&gt;- доверие к цифрам, аудит для регулятора&lt;/i&gt;&lt;br/&gt;&lt;b&gt;17.&lt;/b&gt; ML Observability &lt;i&gt;- комплаенс и качество работы моделей в клиниках&lt;/i&gt;&lt;br/&gt;&lt;b&gt;18.&lt;/b&gt; Power BI поверх DWH &lt;i&gt;- легаси с кастомизациями, постепенно выводим&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1FA2;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1740" y="708" width="1000" height="230" as="geometry" />
        </mxCell>

        <mxCell id="q4_h" value="Практики и методологии" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F57F17;strokeColor=#E65100;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1740" y="958" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="q4_b" value="&lt;b&gt;19.&lt;/b&gt; DDD и доменная декомпозиция &lt;i&gt;- независимость всех направлений&lt;/i&gt;&lt;br/&gt;&lt;b&gt;20.&lt;/b&gt; Data Contracts между доменами &lt;i&gt;- подключение партнёров без правки ядра&lt;/i&gt;&lt;br/&gt;&lt;b&gt;21.&lt;/b&gt; Data Mesh как организационная модель &lt;i&gt;- масштабирование на новые бизнесы&lt;/i&gt;&lt;br/&gt;&lt;b&gt;22.&lt;/b&gt; Team Topologies (stream-aligned teams) &lt;i&gt;- TTM и независимость команд&lt;/i&gt;&lt;br/&gt;&lt;b&gt;23.&lt;/b&gt; Platform Engineering &lt;i&gt;- общая платформа данных как внутренний продукт&lt;/i&gt;&lt;br/&gt;&lt;b&gt;24.&lt;/b&gt; Моно-DWH команда как единственный поставщик &lt;i&gt;- блокер TTM, распускается постепенно&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=12;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1740" y="994" width="1000" height="230" as="geometry" />
        </mxCell>

        <!-- Footer note -->
        <mxCell id="footer" value="Статус технологии (Adopt / Trial / Assess / Hold) виден по её положению в соответствующем кольце радара. Цвет точки показывает квадрант." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1740" y="1240" width="1000" height="40" as="geometry" />
        </mxCell>

